+    OutputRedirectSink::OutputRedirectSink( std::FILE* originalSource,
+                                            std::string filePath ):
+        m_tempFile{ filePath } {
+        m_originalSourceDescriptor = fileno( originalSource );
+        m_originalSourceCopyDescriptor = ::dup( m_originalSourceDescriptor );
+        if ( m_originalSourceCopyDescriptor == -1 ) {
+            CATCH_RUNTIME_ERROR(
+                "Could not duplicate descriptor for source file." );
+        }
+        if ( setvbuf( originalSource, NULL, _IONBF, 0 ) ) {
+            CATCH_RUNTIME_ERROR(
+                "Could not turn off buffering for source file." );
+        }
+        if ( ::dup2( fileno( m_tempFile.getFile() ),
+                     m_originalSourceDescriptor ) == -1 ) {
+            CATCH_RUNTIME_ERROR(
+                "Could not redirect source descriptor to temp file." );
+        }
+    }
+
+    OutputRedirectSink::~OutputRedirectSink() {
+        (void)::dup2( m_originalSourceCopyDescriptor,
+                      m_originalSourceDescriptor );
+    }
+
+    void OutputRedirectSink::reset() {
+        (void)::dup2( m_originalSourceCopyDescriptor,
+                      m_originalSourceDescriptor );
+        m_tempFile.reopen();
+        (void)::dup2( fileno( m_tempFile.getFile() ),
+                      m_originalSourceDescriptor );
+        m_lastGetPosition = 0;
     }
 
